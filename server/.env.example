# Copy this file to .env and fill in the values. Never commit .env.

# Any PostgreSQL 13+ database. Examples:
#   Local Postgres: postgresql://postgres:postgres@localhost:5432/task_tracker
#   Neon (pooled):  postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_tracker

PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (min 16 chars; use 32+ in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
